# LLM — OpenAI 호환 엔드포인트. 회사 LLM 게이트웨이로 옮길 때 LLM_BASE_URL 만 바꾼다 (비우면 OpenAI)
LLM_API_KEY=sk-...
LLM_BASE_URL=
AGENT_MODEL=gpt-4o
ROUTER_MODEL=gpt-4o-mini
AUTO_SKILL=1
# 답변 품질 — 낮은 temperature, tool 호출 한도(넘으면 지금까지 결과로 정리), 원문으로 넣을 최근 대화 턴 수
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOOL_ROUNDS=8
AGENT_HISTORY_TURNS=10

# MCP (mcp_servers.yaml 참고)
EXAMPLE_MCP_URL=http://localhost:8100/mcp
COMPANY_MCP_ENABLED=false
COMPANY_MCP_URL=https://mcp.example.com/mcp
COMPANY_MCP_TOKEN=
MCP_REFRESH_SEC=60

# 첨부 이미지 해석 — 사내 VLM(vLLM 등 OpenAI 호환). 비우면 LLM_* 설정 사용
#   VISION_MODE: describe(VLM 이 텍스트로 해석 → agent 에 전달, 기본) | direct(agent 모델에 이미지 그대로) | off
VISION_MODE=describe
VISION_BASE_URL=
VISION_MODEL=gpt-4o
VISION_API_KEY=
VISION_MAX_TOKENS=1500
UPLOAD_MAX_MB=10

# 추천 후속 질문 — 답변마다 가벼운 모델 1회 호출 (끄려면 0)
SUGGEST_ENABLED=1
SUGGEST_MODEL=gpt-4o-mini

# 이벤터 자동 실행 (1 이면 스케줄대로 LLM 호출)
HUB_SCHEDULER=0

# 사용자 식별 — 회사 SSO 게이트웨이가 넣는 헤더 이름 (헤더가 없으면 DEV_USER_* 로 처리)
USER_ID_HEADER=X-User-Id
USER_NAME_HEADER=X-User-Name
USER_DEPT_HEADER=X-User-Dept
DEV_USER_ID=dev.user
DEV_USER_NAME=개발 사용자
# 회사 사용자 API (선택) — {user_id} 자리에 사번/계정이 들어간다. 응답 JSON 의 name/dept/email 사용
USER_INFO_URL=
USER_INFO_TOKEN=

# 사용자 메모리 (대화 끝날 때마다 md 갱신 — 턴당 ROUTER급 모델 1회 호출)
MEMORY_ENABLED=1
MEMORY_MODEL=gpt-4o-mini
MEMORY_MAX_CHARS=3000
USER_DB_PATH=
